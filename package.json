{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "^0.7.1",
    "onnxruntime-node": "^1.30.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "prettier": "^3.9.9",
    "typebox": "^1.3.34",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "bench:recall": "vitest run --config scripts/bench.config.ts",
    "bench:review-models": "vitest run --config scripts/bench-review-models.config.ts",
    "eval:review": "vitest run --config scripts/eval-review.config.ts",
    "check": "tsc --noEmit && vitest run",
    "check:format": "prettier --check extensions lib scripts tests",
    "format": "prettier --write extensions lib scripts tests",
    "postinstall": "node scripts/fetch-model.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "warm:store": "taskpolicy -c background vitest run --config scripts/warm-store.config.ts"
  }
}
