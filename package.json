{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"dependencies": {
		"@earendil-works/pi-tui": "^0.87.1",
		"@modelcontextprotocol/sdk": "^1.30.1",
		"typebox": "^1.3.34",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@vitest/coverage-v8": "^5.0.2",
		"prettier": "^3.9.9",
		"typescript": "^5",
		"vitest": "^5.0.2"
	},
	"scripts": {
		"test": "vitest run",
		"check": "tsc --noEmit && vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write extensions tests",
		"check:format": "prettier --check extensions tests"
	}
}
