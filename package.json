{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-node": "^1.30.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@vitest/coverage-v8": "^5.0.2",
    "prettier": "^3.9.9",
    "typebox": "^1.3.34",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "bench:recall": "vitest run --config scripts/bench.config.ts",
    "check": "tsc --noEmit && vitest run",
    "check:format": "prettier --check extensions lib tests",
    "format": "prettier --write extensions lib tests",
    "postinstall": "node scripts/fetch-model.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "warm:store": "taskpolicy -c background vitest run --config scripts/warm-store.config.ts"
  }
}
